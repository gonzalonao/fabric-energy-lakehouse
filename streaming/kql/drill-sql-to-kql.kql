// P2 Phase A — SQL to KQL translation drill
//
// Five queries taken from work already done against Gold in P1, not from a tutorial.
// Translate each one BY HAND. Cheat sheet allowed; no AI, no worked examples.
//
// The harness below defines the three tables as `datatable` literals, so every
// translation is runnable against an empty `eh_energy` database before a single real
// row has been ingested. Paste the harness plus one translation into a KQL queryset and
// run it.
//
// The point is not the syntax. It is noticing where KQL is genuinely a different shape:
// time bucketing is a function on the value rather than a GROUP BY expression, "latest
// row per key" is one operator rather than a self-join, and there is no SELECT list at
// the front — the pipeline reads in the order it executes.

let dim_technology = datatable(technology: string, is_renewable: bool)
[
    "Eólica", true,
    "Solar fotovoltaica", true,
    "Hidráulica", true,
    "Nuclear", false,
    "Ciclo combinado", false,
    "Carbón", false,
];
let fact_demand_daily = datatable(date: datetime, demand_mwh: real)
[
    datetime(2024-03-01), 812345.0,
    datetime(2024-03-02), 745120.5,
    datetime(2024-03-15), 798004.2,
    datetime(2024-04-01), 760331.8,
    datetime(2024-04-02), 771902.4,
    datetime(2025-03-01), 803118.9,
];
let fact_generation_daily = datatable(date: datetime, technology: string, generation_mwh: real)
[
    datetime(2024-03-01), "Eólica", 210433.0,
    datetime(2024-03-01), "Solar fotovoltaica", 118220.5,
    datetime(2024-03-01), "Nuclear", 152900.0,
    datetime(2024-03-01), "Ciclo combinado", 96110.2,
    datetime(2024-03-02), "Eólica", 233871.4,
    datetime(2024-03-02), "Hidráulica", 88420.0,
    datetime(2024-03-02), "Carbón", 4120.6,
    datetime(2024-04-01), "Eólica", 175002.3,
    datetime(2024-04-01), "Nuclear", 151004.8,
];
let fact_price_hourly = datatable(datetime_utc: datetime, series: string, price_eur_mwh: real)
[
    datetime(2024-03-01 00:00), "Precio mercado spot", 84.21,
    datetime(2024-03-01 01:00), "Precio mercado spot", 79.05,
    datetime(2024-03-01 02:00), "Precio mercado spot", -3.40,
    datetime(2024-03-01 19:00), "Precio mercado spot", 168.90,
    datetime(2024-03-01 20:00), "Precio mercado spot", 175.33,
    datetime(2024-03-02 19:00), "Precio mercado spot", 141.77,
    datetime(2024-03-01 00:00), "PVPC", 121.44,
    datetime(2024-03-01 19:00), "PVPC", 203.18,
];
