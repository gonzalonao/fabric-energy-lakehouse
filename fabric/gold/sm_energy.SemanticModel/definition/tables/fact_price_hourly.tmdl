table fact_price_hourly
	lineageTag: a0081988-205e-473f-b697-6188bea3ccdf
	sourceLineageTag: [gold].[fact_price_hourly]

	measure 'Avg Price (€/MWh)' = AVERAGE(fact_price_hourly[price_eur_mwh])
		formatString: 0.00
		lineageTag: 7a7e8a9c-d94c-439e-98bf-49298b73a90b

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Price 30D' =
			
			AVERAGEX(
			    DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -30, DAY),
			    [Avg Price (€/MWh)]
			)
		formatString: 0.00
		lineageTag: 999fd6b1-71b3-4ba6-96df-2e802ddcda60

		changedProperty = Name

		changedProperty = FormatString

	measure 'Min Price' = MIN(fact_price_hourly[price_eur_mwh])
		lineageTag: 5bee8774-d5ee-48dd-8927-044b4a7e01af

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Price' = MAX(fact_price_hourly[price_eur_mwh])
		lineageTag: 6489d413-a097-48a9-8e37-af96732baeb8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

