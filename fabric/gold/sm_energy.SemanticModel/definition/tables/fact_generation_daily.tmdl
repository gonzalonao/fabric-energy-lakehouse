table fact_generation_daily
	lineageTag: 45898db5-6d3c-4d2f-ae88-2a4cc3feba5f
	sourceLineageTag: [gold].[fact_generation_daily]

	measure 'Renewables Share %' =
			
			DIVIDE(
			    CALCULATE(SUM(fact_generation_daily[generation_mwh]), dim_technology[is_renewable] = TRUE()),
			    SUM(fact_generation_daily[generation_mwh])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 897a80cb-49e5-49aa-b58d-d984135f0b52

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total Generation' = SUM(fact_generation_daily[generation_mwh])
		lineageTag: 7b73b9bc-d220-446e-a2e6-7e7128d4daca

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total Generation, blanked for any period not fully covered by loaded data —
	/// the same completeness rule as Total Demand (Complete Months), and applied for
	/// the same reason: a SUM over a partial month dives at the right edge and reads
	/// as a collapse in output rather than a month still being written.
	///
	/// Deliberately NOT applied to Renewables Share %: that measure is a ratio, and a
	/// ratio over a partial month is a valid number (the share of what has loaded so
	/// far), not a distorted one. Guarding sums and leaving ratios alone is the rule.
	measure 'Total Generation (Complete Months)' =
			VAR LastLoaded = CALCULATE(MAX(fact_generation_daily[date]), REMOVEFILTERS())
			VAR PeriodEnd = EOMONTH(MAX(dim_date[date]), 0)
			RETURN
			    IF(PeriodEnd <= LastLoaded, [Total Generation])
		lineageTag: 3cf71151-a1a0-4659-b321-1b898cd14af0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column date
		dataType: dateTime
		formatString: General Date
		lineageTag: 1376ec0d-5ba8-4831-9eb9-af9399eba74b
		sourceLineageTag: date
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column technology
		dataType: string
		lineageTag: d173d174-81cc-43fe-aa38-877041a4c60c
		sourceLineageTag: technology
		summarizeBy: none
		sourceColumn: technology

		annotation SummarizationSetBy = Automatic

	column generation_mwh
		dataType: double
		lineageTag: 4a90ac58-8bf9-4aac-ac2e-cefb40e8aca6
		sourceLineageTag: generation_mwh
		summarizeBy: sum
		sourceColumn: generation_mwh

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition fact_generation_daily = entity
		mode: directLake
		source
			entityName: fact_generation_daily
			schemaName: gold
			expressionSource: 'DirectLake - lh_energy'

